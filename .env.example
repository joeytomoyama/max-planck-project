# Copy to .env (git-ignored) to set these for `docker compose up`. All optional.

# Host port the app is published on.
APP_PORT=8000

# OpenAI-compatible LLM endpoint for AI Agents when `mock_mode: false` in config.yml.
# Required with mock mode off: LLM_BASE_URL and LLM_MODEL. LLM_API_KEY only if the endpoint needs one.
# Local Ollama example: LLM_BASE_URL=http://host.docker.internal:11434/v1  LLM_MODEL=qwen3.5:9b
# Prompts and parameters (temperature, max_tokens, ...) are in config.yml; see ai_prompts.md.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
