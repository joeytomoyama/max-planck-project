# =============================================
# Max Planck Project Environment Variables
# Copy this file to .env and fill in your values
# =============================================

# PostgreSQL Configuration
POSTGRES_PASSWORD=secretpgpass
POSTGRES_DB=max_planck_project
POSTGRES_PORT=5432

# Backend Configuration
BACKEND_PORT=8000
DEBUG=false

# Frontend Configuration (exposed port for dev, auto in production)
FRONTEND_PORT=3000

# React app API URL (set at build time via docker-compose)
REACT_APP_API_URL=http://localhost:8000

# Optional: Use mock LLM responses for deterministic testing
MOCK_LLM=true
